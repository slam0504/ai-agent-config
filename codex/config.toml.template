# Portable Codex user-level settings. install.sh merges this and the optional
# codex/config.local.toml into ~/.codex/config.toml, preserving local-only keys.
# Approved 2026-09-25 from codex/review/2026-09-25/. Playwright uses @latest: the
# actual MCP version is resolved per machine at launch and is not pinned here.
model = "gpt-6.1-sol"
model_reasoning_effort = "medium"
model_verbosity = "low"

[agents]
default_subagent_model = "gpt-5.6-terra"
default_subagent_reasoning_effort = "medium"
max_concurrent_threads_per_session = 3

[features]
memories = true

[plugins."github@openai-curated"]
enabled = true

[plugins."sepia@sepia"]
enabled = true

[marketplaces.sepia]
source_type = "git"
source = "https://github.com/Nanako0129/sepia.git"

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest"]

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"
