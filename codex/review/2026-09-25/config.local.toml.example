# Pending review; illustrative machine-local settings, not an install target.
# After approval, merge only needed sections into gitignored codex/config.local.toml.
# Replace example paths with real local paths. Do not copy project trust blindly.
# Use ~/.codex/config.toml as the source for missing local project/MCP/TUI sections;
# merge into the existing local file instead of replacing it with this example.
# install.sh concatenates TOML; it does not merge duplicate table definitions.

[projects."/Users/example/path/to/project"]
trust_level = "trusted"

[mcp_servers.zhtw]
command = "/Users/example/.local/bin/zhtw-mcp"

[mcp_servers.agent-mailroom]
command = "/Users/example/path/to/agent-mailroom/.venv/bin/agent-mailroom"
args = ["mcp", "--url", "http://127.0.0.1:8765"]
tool_timeout_sec = 45

# Observed UI state, kept local rather than shared across machines.
[tui]
screen_reader_detection_done = true

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 2
gpt-6-astra = 4
